# ============================================================================
# Variables de entorno — rutadecarrera-platform
# ============================================================================
# Copiar a .env.local (que NUNCA se commitea) y completar.
# En tu computador usa SIEMPRE claves del entorno STAGING, nunca de producción.
#
# REGLA DE SEGURIDAD: las claves secretas NUNCA llevan prefijo NEXT_PUBLIC_.
# Ese prefijo publica la variable en el navegador de cualquier visitante.
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase (solo servidor) — leído por @rcp/shared/db
# Dónde: Supabase → Project Settings → API
# ----------------------------------------------------------------------------
SUPABASE_URL=https://tu-proyecto-staging.supabase.co
# service_role ignora Row Level Security: SOLO servidor, jamás NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# Gemini (solo servidor)
# Dónde: https://aistudio.google.com/app/apikey
# ----------------------------------------------------------------------------
GEMINI_API_KEY=
# Obligatorio: el código no tiene modelo por defecto y falla explícito si falta.
# gemini-2.5-flash (decidido 2026-09-26) fue descontinuado por Google; desde
# 2026-10-03 se usa gemini-3.8-flash (ver docs/decisions/001-gemini-integration.md).
GEMINI_MODEL=gemini-3.8-flash

# ----------------------------------------------------------------------------
# Aplicación (pública: puede ir al navegador)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Se agregarán en la TASK 9 (autenticación), junto con las políticas RLS:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ----------------------------------------------------------------------------
