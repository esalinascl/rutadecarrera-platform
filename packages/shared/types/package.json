{
  "name": "@rcp/types",
  "version": "0.1.0",
  "description": "Tipos y interfaces compartidas de TypeScript",
  "private": true,
  "main": "index.ts",
  "types": "index.ts",
  "files": [
    "*.ts",
    "*.tsx"
  ],
  "scripts": {
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "clean": "rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "jest": "^29.0.0"
  }
}
